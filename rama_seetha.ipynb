import random

def play_game():
    print("✨ Welcome to the Rama Seetha Guessing Game! ✨\n")
    players = ["Player 1", "Player 2", "Player 3", "Player 4"]
    chits = ["Rama", "Sita", "Hanuman", "Ravana"]
    
    # Shuffle and assign roles
    random.shuffle(chits)
    assignments = dict(zip(players, chits))
    
    # Identify who is Rama
    rama_player = [k for k, v in assignments.items() if v == "Rama"][0]
    print(f"👉 You have been assigned the role of: **RAMA** ({rama_player})")
    print("Your mission: Find who holds the 'Sita' chit!\n")
    
    # Display options (excluding Rama)
    suspects = [p for p in players if p != rama_player]
    print(f"The other players are: {', '.join(suspects)}")
    
    # Take player input
    guess = input(f"Who do you think has Sita? ({', '.join(suspects)}): ").strip()
    
    if guess not in suspects:
        print("❌ Invalid player choice!")
        return

    # Reveal results
    actual_sita = [k for k, v in assignments.items() if v == "Sita"][0]
    print("\n--- REVEAL ---")
    for player, role in assignments.items():
        print(f"• {player}: {role}")
        
    print("\n--- SCORE ---")
    if guess == actual_sita:
        print(f"🎉 Correct! You found Sita! {rama_player} (Rama) gets 1000 points!")
    else:
        print(f"😢 Wrong guess! {actual_sita} (Sita) steals your 1000 points!")

# Run the game loop
play_game()
